  m_EditorClassIdentifier: Assembly-CSharp::GestorPreguntas
  preguntas:
  - texto: "\xBFCon cu\xE1l escribes tus tareas?"
    claveRespuesta: teclado
  - texto: "\xBFCu\xE1l tiene teclas con letras y n\xFAmeros?"
    claveRespuesta: teclado
  - texto: "\xBFCu\xE1l mueves con la mano para se\xF1alar en la pantalla?"
    claveRespuesta: raton
  - texto: "\xBFCon cu\xE1l haces clic?"
    claveRespuesta: raton
  - texto: "\xBFCu\xE1l tiene una ruedita para subir y bajar la p\xE1gina?"
    claveRespuesta: raton
  - texto: "\xBFCu\xE1l te da internet en tu casa?"
    claveRespuesta: wifi
  - texto: "\xBFCu\xE1l tiene antenas y luces que parpadean?"
    claveRespuesta: wifi
  - texto: "\xBFCu\xE1l conecta tu tablet a internet sin cables?"
    claveRespuesta: wifi
  - texto: "\xBFCu\xE1l tiene la pantalla donde ves tus videos?"
    claveRespuesta: computadora
  - texto: "\xBFCu\xE1l guarda tus juegos y programas?"
    claveRespuesta: computadora
  meta: 3
  segundosEntrePreguntas: 2.5
